# Secrets — API keys live in .env and must NEVER be committed to git.
.env

# Python's virtual environment (the private copy of Python + libraries for
# this project). It's big, machine-specific, and rebuildable, so don't commit it.
venv/

# Python's compiled cache files — auto-generated, safe to ignore.
__pycache__/
*.pyc

# macOS clutter files.
.DS_Store

# The app's saved runtime data (analysis runs, portfolio history) is generated
# while using the app; git history stays about the CODE, not the data.
dashboard/data/*.json
