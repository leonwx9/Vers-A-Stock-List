# ── HOW TO USE THIS FILE ────────────────────────────────────────────────
# 1. Copy this file and name the copy exactly:  .env
# 2. Fill in the real values in the copy.
# The real .env is listed in .gitignore, so your keys never reach GitHub.

# Which AI service to use. Two options are built in:
#   openrouter  → uses OPENROUTER_API_KEY (get one at openrouter.ai → Keys)
#   anthropic   → uses ANTHROPIC_API_KEY  (get one at console.anthropic.com)
# Switching provider = change this line + fill in the other key. That's it.
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=paste-your-openrouter-key-here
ANTHROPIC_API_KEY=

# Which Claude model each provider should use. Same model family either way,
# so switching provider doesn't change the analysis quality. Only edit these
# if you want a different model (e.g. a cheaper one while testing).
OPENROUTER_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
