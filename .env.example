# ── HOW TO USE THIS FILE ────────────────────────────────────────────────
# 1. Copy this file and name the copy exactly:  .env
# 2. Fill in the real values in the copy.
# The real .env is listed in .gitignore, so your keys never reach GitHub.

# Which AI service to use. Three options are built in:
#   openrouter   → uses OPENROUTER_API_KEY (get one at openrouter.ai → Keys)
#   anthropic    → uses ANTHROPIC_API_KEY  (get one at console.anthropic.com)
#   claude_code  → uses YOUR OWN Claude subscription via headless Claude
#                  Code on this Mac — no key needed, but only works here,
#                  never on the cloud copy. You can also flip this on/off
#                  from the dashboard's own toggle (Stock Searcher panel)
#                  without ever touching this file.
# Switching provider = change this line (+ fill in the matching key, if any).
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=paste-your-openrouter-key-here
ANTHROPIC_API_KEY=

# Which Claude model each provider should use. Same model family either way,
# so switching provider doesn't change the analysis quality. Only edit these
# if you want a different model (e.g. a cheaper one while testing).
OPENROUTER_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Only used by LLM_PROVIDER=claude_code (or when the dashboard toggle is on).
# CLAUDE_CODE_MODEL:  sonnet (default, lighter) or opus (smarter, but drains
#                      your subscription's shared usage window several times
#                      faster than Sonnet — worth knowing before you turn on
#                      the overnight scheduler).
# CLAUDE_CODE_EFFORT: low / medium (default) / high / xhigh / max — how hard
#                      it thinks. Higher = better answers, more usage spent.
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_EFFORT=medium

# Set to 1 while tinkering with the code: the server auto-reloads on every
# edit and shows rich error pages — but it becomes reachable from THIS
# computer only (the debug console can run code, so it must never face the
# network). Leave empty for normal use, where your phone can connect.
DASHBOARD_DEBUG=

# ── Cloud hosting (leave empty for local/Tailscale use) ─────────────────
# Set a password and every page will require it (remembered ~30 days).
DASHBOARD_PASSWORD=
# Keeps you logged in across server restarts. Any long random string.
FLASK_SECRET_KEY=

# Optional: how our SEC EDGAR requests identify themselves (good etiquette).
SEC_EDGAR_CONTACT=

# Optional: a free cloud Postgres database (Neon/Supabase connection string).
# Empty = data saved as files in dashboard/data/ (fine on the Mac).
# Set   = data saved in the database instead. Set the SAME string on the Mac
#         AND on Render to make both copies share one live set of data (the
#         phone then shows the Mac's real portfolio, not a resetting copy).
DATABASE_URL=

# Set to 1 on RENDER ONLY (never on the Mac). Makes the cloud copy read-only:
# it can view everything and still set price watches / edit watchlists, but
# the server refuses (403) anything that spends AI money or wipes the shared
# portfolio. Only matters once the Mac and cloud share one DATABASE_URL.
VIEWER_MODE=
